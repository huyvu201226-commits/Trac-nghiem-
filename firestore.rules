rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Dữ liệu riêng: chỉ ai biết mã đồng bộ (>= 20 ký tự)
    match /rooms/{code}/{document=**} {
      allow read, write: if code.size() >= 20;
    }

    // Thư viện chung: ai cũng đọc được; chỉ được TẠO MỚI, không sửa/xóa
    match /library/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id','name','topic','n','t','by'])
        && request.resource.data.id == id
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.topic is string && request.resource.data.topic.size() <= 80
        && request.resource.data.by is string && request.resource.data.by.size() <= 40
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 5000
        && request.resource.data.t is int;
      allow update, delete: if false;
    }
    match /libq/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['id','qs'])
        && request.resource.data.id == id
        && request.resource.data.qs is string && request.resource.data.qs.size() <= 900000;
      allow update, delete: if false;
    }
  }
}
